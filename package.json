{
  "name": "@_linked/translation",
  "description": "LINKED translation management — graph-native i18n keys + units, Tolgee-compatible client, CDN delivery. Built inside Create Now for now; structured to extract to its own repo unchanged.",
  "version": "0.1.0",
  "linkedPackage": true,
  "type": "module",
  "main": "lib/esm/index.js",
  "types": "./lib/esm/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/linked-cm/translation.git"
  },
  "homepage": "https://github.com/linked-cm/translation#readme",
  "bugs": {
    "url": "https://github.com/linked-cm/translation/issues"
  },
  "files": [
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "npm exec linked dev",
    "build": "npm exec linked build",
    "test": "vitest run",
    "prepublishOnly": "npm exec linked build production",
    "postpublish": "npm exec linked register"
  },
  "keywords": [
    "linked",
    "linked data",
    "i18n",
    "translation",
    "localization"
  ],
  "module": "lib/esm/index.js",
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "development": "./src/index.ts",
      "import": "./lib/esm/index.js"
    },
    "./react": {
      "types": "./lib/esm/react.d.ts",
      "development": "./src/react.tsx",
      "import": "./lib/esm/react.js"
    },
    "./key-sync": {
      "types": "./lib/esm/key-sync.d.ts",
      "development": "./src/key-sync.ts",
      "import": "./lib/esm/key-sync.js"
    },
    "./capability": {
      "types": "./lib/esm/capability.d.ts",
      "development": "./src/capability.ts",
      "import": "./lib/esm/capability.js"
    },
    "./*.js": {
      "types": "./lib/esm/*.d.ts",
      "development": "./src/*.ts",
      "import": "./lib/esm/*.js"
    },
    "./*": {
      "types": "./lib/esm/*.d.ts",
      "development": "./src/*.ts",
      "import": "./lib/esm/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "lib/esm/*"
      ]
    }
  },
  "dependencies": {
    "@_linked/core": "2.14.4",
    "@_linked/server-utils": "^1.1.0"
  },
  "peerDependencies": {
    "react": "*",
    "typescript": ">=5.7.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@_linked/cli": "^1.11.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.13.14",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "5.7.3",
    "vitest": "^3.2.4"
  }
}
